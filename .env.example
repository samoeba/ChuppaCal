# Public project configuration (never put service-role secrets in NEXT_PUBLIC_*).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Server only; use a separate test project while developing.
SUPABASE_SERVICE_ROLE_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
CRON_SECRET=

# Optional: weather stays hidden when unset.
OPENWEATHER_API_KEY=

# Operator-only, optional. Direct Postgres URL for a pre-migration live backup;
# never expose it through NEXT_PUBLIC_* or commit it. Requires pg_dump >= server major.
SUPABASE_DB_URL=
